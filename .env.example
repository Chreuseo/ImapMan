IMAPMAN_SERVER_ADDRESS=:8080
IMAPMAN_DATABASE_DRIVER=mysql
IMAPMAN_DATABASE_DSN=imapman:change-me@tcp(mariadb:3306)/imapman?parseTime=true
IMAPMAN_API_SECRET=replace-with-a-long-random-secret
IMAPMAN_SMTP_HOST=smtp.example.com
IMAPMAN_SMTP_PORT=587
IMAPMAN_SMTP_USERNAME=distribution@example.com
IMAPMAN_SMTP_PASSWORD_ENV=SMTP_PASSWORD
IMAPMAN_SMTP_FROM=distribution@example.com
IMAPMAN_DELIVERY_BATCH_SIZE=50
IMAPMAN_DELIVERY_USE_BCC=true
IMAPMAN_DELIVERY_TO_HEADER=undisclosed
IMAPMAN_DELIVERY_DELAY_BETWEEN=1s
IMAPMAN_PROCESSING_POLL_INTERVAL=1m
IMAPMAN_PROCESSING_REPROCESS_FAILED=true
IMAPMAN_PROCESSING_MAX_ATTEMPTS=3
SMTP_PASSWORD=change-me
MARIADB_DATABASE=imapman
MARIADB_USER=imapman
MARIADB_PASSWORD=change-me
MARIADB_ROOT_PASSWORD=change-root-password
